{
  "name": "vite-devtools-svelte-inspector",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte Inspector for vite-devtools-svelte, forked from @sveltejs/vite-plugin-svelte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/vite-devtools-svelte.git",
    "directory": "packages/inspector"
  },
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.runtime.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
