{
  "name": "vite-devtools-svelte-inspector",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte Inspector for vite-devtools-svelte, forked from @sveltejs/vite-plugin-svelte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/vite-devtools-svelte.git",
    "directory": "packages/inspector"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.runtime.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "obug": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.46.4",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
