{
  "name": "vite-devtools-svelte",
  "version": "0.6.2",
  "description": "Svelte DevTools for Vite: standalone on your dev server or inside the Vite DevTools dock",
  "keywords": [
    "devtools",
    "svelte",
    "sveltekit",
    "vite",
    "vite-devtools",
    "vite-plugin"
  ],
  "homepage": "https://github.com/baseballyama/vite-devtools-svelte#readme",
  "bugs": {
    "url": "https://github.com/baseballyama/vite-devtools-svelte/issues"
  },
  "license": "MIT",
  "author": "Yuichiro Yamashita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baseballyama/vite-devtools-svelte.git",
    "directory": "packages/vite-devtools-svelte"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitejs/devtools-kit": "^0.8.0",
    "devframe": "^1.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0 || ^3.0.0",
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
