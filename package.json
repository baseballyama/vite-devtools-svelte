{
  "name": "vite-devtools-svelte-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "pnpm -C packages/vite-devtools-svelte/client build",
    "build:plugin": "pnpm -C packages/vite-devtools-svelte build",
    "build": "pnpm build:plugin && pnpm build:client",
    "dev": "pnpm build && pnpm -C playground dev",
    "dev:ui": "pnpm build && pnpm -C playground dev:ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "perf:fixture": "node perf/generate-large-app.mjs",
    "perf:bench": "node perf/bench-browser.mjs",
    "perf:noop": "node perf/check-prod-noop.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "axe-core": "^4.11.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.67.0",
    "playwright-core": "1.63.0"
  },
  "packageManager": "pnpm@12.9.1"
}
