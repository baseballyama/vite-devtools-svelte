{
  "name": "kit-config",
  "version": "0.0.1",
  "private": true,
  "description": "SvelteKit with non-default config: paths.base, appDir, files.routes, trailingSlash, embedded",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-devtools-svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/devtools": "^0.8.3",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "devtoolsExample": {
    "port": 5211,
    "base": "/base/"
  }
}
