{
  "name": "kit-spa",
  "version": "0.0.1",
  "private": true,
  "description": "SvelteKit SPA: ssr = false everywhere, universal loads run in the browser only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-devtools-svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/devtools": "^0.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "devtoolsExample": {
    "port": 5208
  }
}
