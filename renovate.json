{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":maintainLockFilesWeekly",
    "group:allNonMajor",
    "schedule:weekends"
  ],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Group all type definitions",
      "matchPackageNames": ["/^@types//"],
      "groupName": "type definitions"
    },
    {
      "description": "Group changesets tooling",
      "matchPackageNames": ["@changesets/cli", "@changesets/changelog-github"],
      "groupName": "changesets"
    },
    {
      "description": "Group vitest tooling",
      "matchPackageNames": ["/^vitest/", "/^@vitest//"],
      "groupName": "vitest"
    },
    {
      "description": "Group Svelte / SvelteKit / Vite tooling",
      "matchPackageNames": ["/^@sveltejs//", "/^svelte/", "/^vite/", "/^@vitejs//"],
      "groupName": "svelte-vite"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "description": "compat/kit3 depends on the packed tarball (compat/.pack), which does not exist in Renovate's checkout, so its lockfile cannot be regenerated from scratch. Skip lock file maintenance there only; dependency updates still apply. Refresh it by hand (compat/README.md).",
      "matchFileNames": ["compat/kit3/package.json"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "description": "examples/sample-app is the SvelteKit 2 compat profile (compat/matrix.json). Keep it on Kit 2: no major updates of Kit or its adapter there; minor/patch still apply.",
      "matchFileNames": ["examples/sample-app/package.json"],
      "matchPackageNames": ["@sveltejs/kit", "@sveltejs/adapter-auto"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep typescript on 6.x for peers and API consumers (svelte-check peers ^5 || ^6). matchDepNames matches only the manifest key, so the root @typescript/native alias (TypeScript 7, packageName typescript) still updates. Do not switch this to matchPackageNames.",
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Pin Node engine: support all active LTS lines, no auto-bumps",
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "description": "Pin @types/node to the lowest supported Node major; no auto-bumps",
      "matchPackageNames": ["@types/node"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/__tests__/fixtures/**"]
}
