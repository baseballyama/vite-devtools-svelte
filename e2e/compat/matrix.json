{
  "$comment": "Compatibility profiles for e2e/compat (CI job `e2e`, compat entries). Versions are exact and must match the fixture's package.json; update by hand (e2e/compat/README.md). One profile per framework line, not a cross product. Both modes use the app's vite.config.ts; --dock sets SVELTE_DEVTOOLS_DOCK=1, which that config reads. `smoke` tells smoke.mjs what to edit (HMR) and which route to check (SSR / load). `smoke.stateChange` = one scripted click (a CSS selector, or {role, name} for an accessible-name lookup) and the component-init $state it must change (seen through MCP after the 200 ms sampling); null = not defined yet → reported NOT RUN, never PASS.",
  "profiles": [
    {
      "id": "plain-svelte",
      "dir": "examples/plain-svelte",
      "workspace": true,
      "framework": "svelte",
      "modes": ["standalone", "dock"],
      "versions": {
        "svelte": "5.57.3",
        "vite": "8.3.8",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@vitejs/devtools": "0.8.3"
      },
      "smoke": {
        "hmr": {
          "file": "src/App.svelte",
          "from": "<h1>plain-svelte</h1>",
          "to": "<h1>plain-svelte (smoke)</h1>",
          "text": "plain-svelte (smoke)"
        },
        "stateChange": {
          "path": "/",
          "click": "[data-testid=\"increment\"]",
          "file": "src/lib/Counter.svelte",
          "state": "count",
          "from": 1,
          "to": 2
        }
      }
    },
    {
      "id": "kit3",
      "dir": "e2e/compat/kit3",
      "workspace": false,
      "framework": "kit",
      "modes": ["standalone", "dock"],
      "versions": {
        "@sveltejs/kit": "3.3.1",
        "svelte": "5.57.3",
        "vite": "8.3.8",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@sveltejs/adapter-auto": "8.0.1",
        "@vitejs/devtools": "0.8.3"
      },
      "smoke": {
        "hmr": {
          "file": "src/routes/+page.svelte",
          "from": "<h1>kit3 compat</h1>",
          "to": "<h1>kit3 compat (smoke)</h1>",
          "text": "kit3 compat (smoke)"
        },
        "ssr": {
          "path": "/",
          "contains": "kit3 compat"
        },
        "load": {
          "path": "/"
        },
        "stateChange": {
          "path": "/",
          "click": "[data-testid=\"count-button\"]",
          "file": "src/routes/+page.svelte",
          "state": "clicks",
          "from": 0,
          "to": 1
        }
      }
    }
  ]
}
