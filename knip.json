{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.mjs",
        "perf/*.mjs",
        "scripts/*.mjs",
        "scripts/screenshots/*.mjs",
        ".claude/skills/**/*.mjs"
      ],
      "project": ["e2e/**/*.mjs", "perf/**/*.mjs", "scripts/**/*.mjs"],
      "ignoreDependencies": ["axe-core"]
    },
    "packages/vite-devtools-svelte": {
      "entry": ["src/types.ts", "src/runtime/client.js", "src/runtime/wrapper.js", "test/**/*.ts"],
      "project": ["src/**/*.{ts,js}", "test/**/*.{ts,svelte}"],
      "ignore": ["test/fixtures/**"]
    },
    "packages/inspector": {
      "entry": [
        "src/runtime/devtools-action.ts",
        "src/runtime/settings-view.ts",
        "src/runtime/*.svelte",
        "test/**/*.ts"
      ],
      "project": ["src/**/*.{ts,svelte}", "test/**/*.ts"]
    },
    "packages/client": {
      "project": ["src/**/*.{ts,svelte}", "dev/**/*.ts", "test/**/*.ts"]
    },
    "site": {
      "entry": ["scripts/*.mjs"]
    },
    "examples/kit-shop": {
      "entry": ["vite.standalone.config.ts"]
    },
    "examples/svelte-middleware": {
      "entry": ["src/entry-server.ts"]
    },
    "examples/kit-config": {
      "entry": ["src/app-routes/**/+*.{ts,svelte}"]
    },
    "examples/kit-routing": {
      "entry": ["src/params.ts"]
    }
  },
  "ignoreBinaries": ["top", "svelte-check", "svelte-kit"],
  "ignoreIssues": {
    "{examples/*,playground,site}/tsconfig.json": ["unlisted"]
  }
}
