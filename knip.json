{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.mjs", "perf/*.mjs", "scripts/**/*.mjs", ".claude/skills/**/*.mjs"],
      "project": ["e2e/**/*.mjs", "perf/**/*.mjs", "scripts/**/*.mjs"],
      "ignoreDependencies": ["axe-core"]
    },
    "packages/vite-devtools-svelte": {
      "entry": ["src/types.ts", "src/runtime/client.js", "src/runtime/wrapper.js", "test/**/*.ts"],
      "project": ["src/**/*.{ts,js}", "test/**/*.{ts,svelte}"],
      "ignore": ["test/fixtures/**"]
    },
    "packages/client": {
      "entry": ["dev/vite.mock.config.ts"],
      "project": ["src/**/*.{ts,svelte}", "dev/**/*.ts", "test/**/*.ts"]
    },
    "site": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["@vitejs/devtools"]
    },
    "examples/sample-app": {
      "entry": ["vite.standalone.config.ts"]
    }
  },
  "ignoreBinaries": ["top", "svelte-check", "svelte-kit"]
}
